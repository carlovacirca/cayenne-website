---
/* The private review page for a draft: opened from the morning email, or by the approver when signed in */
import Base from '../../layouts/Base.astro';
import guideHead from '../../html/guide.head.html?raw';
import insHead from '../../html/insights.head.html?raw';
import { getEdition, editionBody, isDate, tokenOk, reviewToken, isApprover, ukDate } from '../../lib/insights';
import { currentUser, E } from '../../lib/server';
export const prerender = false;
Astro.response.headers.set('cache-control', 'no-store');
const url = Astro.url;
const date = url.searchParams.get('d') || ukDate();
const user = await currentUser(Astro.request);
const allowed = isDate(date) && ((await tokenOk(date, url.searchParams.get('t'))) || isApprover(user?.email));
const ed = allowed ? await getEdition(date) : null;
const token = allowed && E.SESSION_SECRET ? await reviewToken(date) : '';
const msg = !allowed ? 'This review link has expired or is not valid. Open the latest email, or sign in as the approver.'
  : !ed ? 'There is no draft for this day yet. The morning run writes one at about 6am.'
  : ed.status === 'published' ? 'This briefing is already live.' : ed.status === 'skipped' ? 'You skipped this one. Nothing was published.' : '';
/* the approver, signed in with Google, can write the draft by hand when the morning run has not */
const canRun = !ed && isApprover(user?.email);
const runScript = `<script>(function(){var b=document.getElementById('ins-run');b.addEventListener('click',function(){b.disabled=true;b.textContent='Writing, this takes two to four minutes';
fetch('/api/insights/run',{method:'POST'}).then(function(r){return r.json();}).then(function(j){if(j.ok)location.reload();else{b.disabled=false;b.textContent='Try again';window.cayenneToast&&cayenneToast(j.error||'That did not work');}},function(){b.disabled=false;b.textContent='Try again';});});})();</script>`;
const note = `<div id="stage"><div id="app" class="app"><section class="snap hero" id="top"><div class="heat" aria-hidden="true"><i class="h1"></i><i class="h2"></i></div><div class="hero-main wrap intro ins-wait-in"><span class="sec-k in"><i aria-hidden="true"></i>Insights review</span><h1 class="gd-h in d1">Nothing to <em>approve.</em></h1><p class="lede in d2">${msg}</p><div class="ins-row in d3">${canRun ? '<button class="btn-create" type="button" id="ins-run">Write today\u2019s draft now</button>' : '<a class="btn-create" href="/insights">See Insights</a>'}</div></div></section></div></div><div class="toast" id="toast" role="status" hidden></div><script src="/site.js"></script>${canRun ? runScript : ''}`;
---
<Base title="Review today's Insights · Cayenne" description="Private review page." page="insights-review.html" head={'<meta name="robots" content="noindex,nofollow">' + guideHead + insHead} body={ed && ed.status === 'draft' ? editionBody(ed, { review: { token } }) : note} />
